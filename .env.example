# PostgreSQL database connection
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# JWT signing secret - generate a secure random value locally
JWT_SECRET="replace-with-a-secure-random-secret"

# Backend server port
PORT=3000

# Observe telemetry credentials (optional for local development)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=project-zero
